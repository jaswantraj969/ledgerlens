# Copy to .env. Replace every "change-me" value before running anywhere but your own machine.

# PostgreSQL container credentials
POSTGRES_DB=ledgerlens
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=change-me

# Application
LEDGERLENS_DATABASE_URL=postgresql+psycopg://ledgerlens:change-me@127.0.0.1:5433/ledgerlens
LEDGERLENS_REDIS_URL=redis://127.0.0.1:6380/0
# At least 32 random bytes. Used to sign access tokens.
LEDGERLENS_JWT_SECRET=change-me
